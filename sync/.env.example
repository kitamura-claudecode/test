# Apple ID (iCloud アカウントのメールアドレス)
APPLE_ID=kitamura@example.com

# https://appleid.apple.com で発行した「アプリ用パスワード」
# 通常の Apple ID パスワードは CalDAV では使えない
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google OAuth クライアントシークレット JSON のパス
# Google Cloud Console で「デスクトップアプリ」種別の OAuth クライアントを作成して取得
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json

# OAuth で取得したトークン (refresh token 含む) の保存先
GOOGLE_TOKEN_FILE=credentials/token.json
